# Data: only storage documentation and empty directory markers are tracked
/data/**
!/data/README.md
!/data/raw/
!/data/raw/.gitkeep
!/data/interim/
!/data/interim/.gitkeep
!/data/processed/
!/data/processed/.gitkeep
!/data/external/
!/data/external/.gitkeep
!/data/splits/
!/data/splits/.gitkeep

