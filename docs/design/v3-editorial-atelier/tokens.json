{
  "$description": "Cue design tokens v3.0 (Editorial Atelier). Tiers: primitive -> semantic -> component. Components use semantic/component tokens only; no hex in JSX/CSS outside tokens. Contrast ratios: ACCESSIBILITY_AUDIT.md.",
  "primitive": {
    "color": {
      "gold-500": "#FFB509",
      "gold-100": "#FFEFC2",
      "purple-900": "#2E0C3A",
      "purple-800": "#431452",
      "purple-700": "#5A2370",
      "purple-100": "#EFE4F3",
      "paper-300": "#EBDFC8",
      "paper-200": "#F5EBD8",
      "paper-100": "#FFFAF0",
      "paper-50": "#F9F1E0",
      "ink-900": "#241629",
      "ink-700": "#4D3D55",
      "ink-600": "#6E5F76",
      "line-500": "#85748A",
      "blue-700": "#23437C",
      "blue-100": "#E1E9F4",
      "orange-500": "#ED782A",
      "orange-700": "#B4440F",
      "orange-600": "#C4531A",
      "orange-100": "#FBE2CC",
      "red-700": "#A1413C",
      "red-100": "#F8E0DC",
      "green-700": "#2F6B3B",
      "green-100": "#DFEBD9",
      "amber-800": "#7A4F00",
      "viewer-900": "#17101C"
    },
    "font-family": {
      "display": "'Fraunces', 'Iowan Old Style', Georgia, serif",
      "ui": "'Manrope', 'Segoe UI', system-ui, sans-serif"
    },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
    "radius": { "sm": "4px", "md": "8px", "lg": "14px", "pill": "999px" },
    "duration": { "instant": "80ms", "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "enter": "cubic-bezier(0, 0, 0, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" }
  },
  "semantic": {
    "color": {
      "bg-nav": "{primitive.color.purple-800}",
      "bg-ground-gold": "{primitive.color.gold-500}",
      "bg-ground-paper": "{primitive.color.paper-200}",
      "bg-sheet": "{primitive.color.paper-200}",
      "bg-surface-raised": "{primitive.color.paper-100}",
      "bg-surface-sunken": "{primitive.color.paper-300}",
      "bg-upload": "{primitive.color.paper-50}",
      "bg-canvas": "{primitive.color.paper-100}",
      "bg-viewer": "{primitive.color.viewer-900}",
      "text-primary": "{primitive.color.ink-900}",
      "text-secondary": "{primitive.color.ink-700}",
      "text-muted": "{primitive.color.ink-600}",
      "text-on-nav": "{primitive.color.paper-100}",
      "text-on-action": "{primitive.color.paper-100}",
      "text-link": "{primitive.color.purple-800}",
      "text-orange": "{primitive.color.orange-700}",
      "nav-indicator": "{primitive.color.gold-500}",
      "action-primary": "{primitive.color.purple-800}",
      "action-primary-hover": "{primitive.color.purple-700}",
      "action-primary-active": "{primitive.color.purple-900}",
      "action-secondary-bg": "{primitive.color.paper-100}",
      "action-secondary-border": "{primitive.color.line-500}",
      "action-danger": "{primitive.color.red-700}",
      "selected-bg": "{primitive.color.purple-100}",
      "selected-outline": "{primitive.color.purple-800}",
      "identity-start": "{primitive.color.purple-800}",
      "identity-end": "{primitive.color.gold-500}",
      "plan-index": "{primitive.color.purple-800}",
      "plan-rail": "{primitive.color.purple-800}",
      "motion-accent": "{primitive.color.orange-600}",
      "border-input": "{primitive.color.line-500}",
      "border-hairline": "rgba(36, 22, 41, 0.12)",
      "border-sheet": "rgba(36, 22, 41, 0.10)",
      "focus-ring": "{primitive.color.purple-800}",
      "focus-gap": "{primitive.color.paper-100}",
      "info": "{primitive.color.blue-700}",
      "info-bg": "{primitive.color.blue-100}",
      "warning": "{primitive.color.amber-800}",
      "warning-bg": "{primitive.color.gold-100}",
      "error": "{primitive.color.red-700}",
      "error-bg": "{primitive.color.red-100}",
      "success": "{primitive.color.green-700}",
      "success-bg": "{primitive.color.green-100}",
      "hover-overlay": "rgba(36, 22, 41, 0.06)",
      "pressed-overlay": "rgba(36, 22, 41, 0.12)"
    },
    "elevation": {
      "0": "none",
      "1": "0 2px 6px rgba(36, 22, 41, 0.14)",
      "2": "0 14px 36px rgba(36, 22, 41, 0.20)",
      "3": "0 22px 56px rgba(36, 22, 41, 0.30)"
    },
    "border": {
      "none": "0",
      "hairline": "1px solid {semantic.color.border-hairline}",
      "control": "1px solid {semantic.color.border-input}",
      "strong": "2px solid {semantic.color.selected-outline}"
    },
    "texture": { "paper-grain-opacity": 0.05, "nav-grain-opacity": 0.06, "ground-grain-opacity": 0.07, "forbidden-on": ["input", "textarea", "video", "drawing", "viewer"] },
    "pattern": {
      "name": "registration-marks",
      "tile": "96px",
      "mark": { "circle-radius": "5px", "cross-length": "22px", "stroke": "1px", "corner-dot": "1.1px" },
      "on-gold": { "color": "{primitive.color.ink-900}", "mark-opacity": 0.20, "dot-opacity": 0.18 },
      "on-paper": { "color": "{primitive.color.purple-800}", "mark-opacity": 0.16, "dot-opacity": 0.14 },
      "placement": ["ground", "s1-brand-panel"],
      "never-under": ["sheet-content", "input", "artwork", "video", "motion-plan"]
    },
    "layout": {
      "nav-height": "64px",
      "nav-rule": "4px (gold, only on paper ground)",
      "page-margin": "40px",
      "sheet-padding": "32px",
      "sheet-radius": "14px",
      "grid-gutter": "24px",
      "media-aspect": "8 / 5"
    }
  },
  "typography": {
    "wordmark":     { "family": "display", "size": "27px", "weight": 800, "line-height": "1", "letter-spacing": "-0.01em" },
    "auth-hero":    { "family": "display", "size": "54px", "weight": 600, "line-height": "62px", "letter-spacing": "-0.02em", "use": "S1 only" },
    "page-title":   { "family": "ui", "size": "28px", "weight": 800, "line-height": "34px", "letter-spacing": "-0.015em" },
    "section-title":{ "family": "ui", "size": "20px", "weight": 800, "line-height": "26px", "letter-spacing": "-0.01em" },
    "group-label":  { "family": "ui", "size": "16px", "weight": 800, "line-height": "22px", "letter-spacing": "0" },
    "card-title":   { "family": "ui", "size": "14.5px", "weight": 700, "line-height": "20px", "letter-spacing": "0" },
    "body":         { "family": "ui", "size": "15px", "weight": 500, "line-height": "24px", "letter-spacing": "0" },
    "body-secondary": { "family": "ui", "size": "14px", "weight": 500, "line-height": "22px", "letter-spacing": "0" },
    "form-label":   { "family": "ui", "size": "13.5px", "weight": 800, "line-height": "20px", "letter-spacing": "0" },
    "metadata":     { "family": "ui", "size": "12.5px", "weight": 500, "line-height": "18px", "letter-spacing": "0.005em", "features": "tnum" },
    "button-label": { "family": "ui", "size": "14.5px", "weight": 700, "line-height": "20px", "letter-spacing": "0" },
    "status-text":  { "family": "ui", "size": "12.5px", "weight": 700, "line-height": "18px", "letter-spacing": "0.01em" },
    "plan-index":   { "family": "display", "size": "18px", "weight": 600, "line-height": "1", "letter-spacing": "0", "features": "lnum" },
    "numeral":      { "family": "ui", "size": "22px", "weight": 700, "line-height": "28px", "letter-spacing": "0", "features": "tnum" }
  },
  "component": {
    "nav": { "height": "64px", "bg": "{semantic.color.bg-nav}", "separator": "rgba(255, 250, 240, 0.18)", "indicator-height": "3px" },
    "sheet": { "radius": "{semantic.layout.sheet-radius}", "bg": "{semantic.color.bg-sheet}", "shadow": "{semantic.elevation.2}", "border": "{semantic.border.hairline}" },
    "button": { "height-sm": "36px", "height-md": "44px", "height-lg": "50px", "radius": "{primitive.radius.md}" },
    "input": { "height": "46px", "radius": "{primitive.radius.md}", "border": "{semantic.border.control}", "bg": "{semantic.color.bg-surface-raised}", "focus": "{semantic.border.strong}" },
    "thumbnail": { "radius": "6px", "aspect": "{semantic.layout.media-aspect}", "shadow": "{semantic.elevation.1}" },
    "chip": { "height": "26px", "radius": "{primitive.radius.pill}", "border": "none" },
    "frame-strip": { "count": 16, "start-color": "{semantic.color.identity-start}", "end-color": "{semantic.color.identity-end}", "end-outline": "1px {primitive.color.ink-900}" },
    "film-strip": { "bg": "{semantic.color.bg-viewer}", "frame-aspect": "{semantic.layout.media-aspect}" },
    "cue-row": { "height": "88px", "index-size": "30px", "rail": "1.5px" },
    "focus": { "ring": "2px {semantic.color.focus-ring}", "gap": "2px {semantic.color.focus-gap}" },
    "target-min": "40px"
  },
  "breakpoint": { "compact": "0", "narrow": "640px", "tablet": "768px", "laptop": "1024px", "desktop": "1280px", "reference": "1440px" },
  "migration-from-v2": {
    "bg-shell": "bg-ground-gold (S1–S4) or bg-ground-paper (S5–S6); no longer the page background everywhere",
    "bg-surface (cream-200)": "bg-sheet (paper-200)",
    "bg-surface-raised (cream-100)": "bg-surface-raised (paper-100)",
    "bg-surface-sunken": "bg-surface-sunken (paper-300)",
    "bg-canvas": "bg-canvas (paper-100)",
    "bg-viewer": "bg-viewer",
    "action-primary (#4F0964)": "action-primary (#431452)",
    "border-strong (ink, 1.5px)": "split into border-hairline, border-input, selected-outline (2px purple)",
    "motion-accent (#D2620F)": "motion-accent (#C4531A)",
    "text-accent-orange (#B03E06)": "text-orange (#B4440F)",
    "focus-ring (ink) + gap (cream)": "focus-ring (purple) + focus-gap (paper-100)",
    "elevation 1 (hard 3px shadow)": "elevation 1 (soft)",
    "wordmark/ticks on gold": "wordmark on purple nav with gold end ticks",
    "typography: screen-title Fraunces 46": "page-title Manrope 28; Fraunces only for auth-hero and plan-index"
  }
}
