{
  "$description": "Cue design tokens v2.0 (Prismatic Paper). Tiers: primitive -> semantic -> component. React/Tailwind code must use semantic or component tokens only. Primitive hex values derive from pixel sampling of the three references (see REFERENCE_IMAGE_ANALYSIS.md); contrast ratios were computed and are listed in ACCESSIBILITY_REPORT.md.",
  "primitive": {
    "color": {
      "gold-300": "#FBC750",
      "gold-500": "#F8AA09",
      "gold-600": "#E68F1F",
      "cream-100": "#FBF3E4",
      "cream-200": "#F6E8D1",
      "cream-300": "#EDE0CA",
      "paper-white": "#FFFDF7",
      "hair-300": "#CDB99A",
      "ink-900": "#241629",
      "ink-700": "#4B3B52",
      "ink-600": "#6B5A72",
      "purple-900": "#3B0650",
      "purple-800": "#4F0964",
      "purple-700": "#65198A",
      "purple-100": "#E8D7F0",
      "blue-800": "#1F3664",
      "blue-700": "#23437C",
      "blue-100": "#DCE5F3",
      "orange-700": "#B03E06",
      "orange-600": "#D2620F",
      "orange-500": "#F88526",
      "orange-100": "#FCE0C4",
      "red-700": "#A1413C",
      "red-100": "#F6D9D4",
      "green-700": "#2F6B3B",
      "green-100": "#D9EAD3",
      "amber-800": "#8A5A00",
      "amber-100": "#FBE6A6",
      "viewer-900": "#1B1220"
    },
    "font-family": {
      "display": "'Fraunces', 'Iowan Old Style', Georgia, serif",
      "ui": "'Manrope', 'Segoe UI', system-ui, sans-serif"
    },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
    "radius": { "sm": "4px", "md": "8px", "lg": "12px", "pill": "999px" },
    "duration": { "instant": "80ms", "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "enter": "cubic-bezier(0, 0, 0, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" }
  },
  "semantic": {
    "color": {
      "bg-shell": "{primitive.color.gold-500}",
      "bg-shell-highlight": "{primitive.color.gold-300}",
      "bg-surface": "{primitive.color.cream-200}",
      "bg-surface-raised": "{primitive.color.cream-100}",
      "bg-surface-sunken": "{primitive.color.cream-300}",
      "bg-canvas": "{primitive.color.paper-white}",
      "bg-viewer": "{primitive.color.viewer-900}",
      "text-primary": "{primitive.color.ink-900}",
      "text-secondary": "{primitive.color.ink-700}",
      "text-muted": "{primitive.color.ink-600}",
      "text-on-action": "{primitive.color.cream-100}",
      "text-link": "{primitive.color.purple-800}",
      "text-accent-orange": "{primitive.color.orange-700}",
      "action-primary": "{primitive.color.purple-800}",
      "action-primary-hover": "{primitive.color.purple-700}",
      "action-primary-active": "{primitive.color.purple-900}",
      "action-secondary-bg": "{primitive.color.cream-100}",
      "action-secondary-border": "{primitive.color.ink-900}",
      "action-danger": "{primitive.color.red-700}",
      "selected-bg": "{primitive.color.purple-100}",
      "selected-border": "{primitive.color.purple-800}",
      "upload-border": "{primitive.color.ink-600}",
      "upload-bg": "{primitive.color.cream-100}",
      "plan-cue-bg": "{primitive.color.purple-100}",
      "plan-cue-number-bg": "{primitive.color.purple-800}",
      "motion-accent": "{primitive.color.orange-600}",
      "motion-accent-fill": "{primitive.color.orange-500}",
      "info": "{primitive.color.blue-700}",
      "info-bg": "{primitive.color.blue-100}",
      "warning": "{primitive.color.amber-800}",
      "warning-bg": "{primitive.color.amber-100}",
      "error": "{primitive.color.red-700}",
      "error-bg": "{primitive.color.red-100}",
      "success": "{primitive.color.green-700}",
      "success-bg": "{primitive.color.green-100}",
      "border-strong": "{primitive.color.ink-900}",
      "border-input": "{primitive.color.ink-600}",
      "border-hair": "{primitive.color.hair-300}",
      "focus-ring": "{primitive.color.ink-900}",
      "focus-gap": "{primitive.color.cream-100}",
      "hover-overlay": "rgba(36, 22, 41, 0.06)",
      "pressed-overlay": "rgba(36, 22, 41, 0.12)"
    },
    "elevation": {
      "0": "none",
      "1": "0 3px 0 rgba(36, 22, 41, 0.16)",
      "2": "0 6px 0 rgba(36, 22, 41, 0.18)",
      "3": "0 10px 24px rgba(36, 22, 41, 0.28)"
    },
    "texture": {
      "grain-opacity-shell": 0.12,
      "grain-opacity-surface": 0.09,
      "fiber-opacity": 0.05,
      "texture-forbidden-on": ["input", "textarea", "video", "drawing", "text-block-over-60ch"]
    },
    "layout": {
      "page-margin-desktop": "40px",
      "page-margin-tablet": "32px",
      "page-margin-mobile": "16px",
      "content-max": "1360px",
      "grid-gutter": "24px",
      "topbar-height": "76px",
      "media-aspect": "8 / 5"
    }
  },
  "typography": {
    "wordmark":        { "family": "display", "size": "34px", "weight": 800, "line-height": "1", "letter-spacing": "-0.01em", "axes": "opsz 72, SOFT 50, WONK 0" },
    "display-hero":    { "family": "display", "size": "72px", "weight": 600, "line-height": "80px", "letter-spacing": "-0.02em", "axes": "opsz 144, SOFT 50, WONK 0", "use": "S1 only" },
    "screen-title":    { "family": "display", "size": "46px", "weight": 600, "line-height": "52px", "letter-spacing": "-0.015em", "axes": "opsz 72, SOFT 50, WONK 0" },
    "section-heading": { "family": "display", "size": "26px", "weight": 600, "line-height": "32px", "letter-spacing": "-0.005em", "axes": "opsz 36, SOFT 50, WONK 0" },
    "card-title":      { "family": "ui", "size": "15px", "weight": 800, "line-height": "22px", "letter-spacing": "0" },
    "body":            { "family": "ui", "size": "16px", "weight": 500, "line-height": "26px", "letter-spacing": "0" },
    "body-secondary":  { "family": "ui", "size": "14px", "weight": 500, "line-height": "22px", "letter-spacing": "0" },
    "form-label":      { "family": "ui", "size": "14px", "weight": 800, "line-height": "20px", "letter-spacing": "0" },
    "metadata":        { "family": "ui", "size": "13px", "weight": 500, "line-height": "20px", "letter-spacing": "0.005em", "features": "tnum" },
    "button-label":    { "family": "ui", "size": "15px", "weight": 700, "line-height": "20px", "letter-spacing": "0.005em" },
    "status-text":     { "family": "ui", "size": "13px", "weight": 700, "line-height": "20px", "letter-spacing": "0.01em" },
    "numeral":         { "family": "display", "size": "22px", "weight": 600, "line-height": "28px", "letter-spacing": "0", "features": "tnum, lnum" }
  },
  "component": {
    "button": { "height-sm": "36px", "height-md": "44px", "height-lg": "50px", "radius": "{primitive.radius.md}", "border": "1.5px solid {semantic.color.border-strong}", "shadow": "{semantic.elevation.1}" },
    "input": { "height": "46px", "radius": "{primitive.radius.md}", "border": "1.5px solid {semantic.color.border-input}", "bg": "{semantic.color.bg-surface-raised}" },
    "panel": { "padding": "28px", "radius": "{primitive.radius.lg}", "border": "1.5px solid {semantic.color.border-strong}", "shadow": "{semantic.elevation.1}", "bg": "{semantic.color.bg-surface}" },
    "gallery-card": { "radius": "10px", "padding": "8px", "thumbnail-aspect": "{semantic.layout.media-aspect}" },
    "chip": { "height": "28px", "radius": "{primitive.radius.pill}" },
    "frame-strip": { "count": 16, "end-tick-color": "{semantic.color.motion-accent}", "tick-color": "{semantic.color.border-strong}" },
    "cue-block": { "height": "50px", "radius": "7px", "bg": "{semantic.color.plan-cue-bg}", "border": "1.5px solid {semantic.color.border-strong}" },
    "focus": { "ring": "2px {semantic.color.focus-ring}", "gap": "2px {semantic.color.focus-gap}" },
    "target-min": "40px"
  },
  "breakpoint": { "compact": "0", "narrow": "640px", "tablet": "768px", "laptop": "1024px", "desktop": "1280px", "reference": "1440px" },
  "migration-from-v1": {
    "bg-app": "bg-shell",
    "bg-canvas": "bg-canvas (meaning kept: surface behind artwork; value changes to paper-white)",
    "bg-surface": "bg-surface",
    "bg-elevated": "bg-surface-raised",
    "bg-overlay": "bg-surface-raised + elevation-3",
    "text-primary": "text-primary",
    "text-secondary": "text-secondary",
    "text-muted": "text-muted",
    "text-disabled": "text-muted on bg-surface-sunken",
    "action-primary (orange)": "action-primary (now purple-800); orange is motion-accent only",
    "selected-bg / selected-border": "selected-bg / selected-border (purple, tint now light)",
    "accent-plan": "plan-cue-number-bg",
    "focus-ring (light lilac)": "focus-ring (ink) + focus-gap (cream)",
    "info / warning / error / success": "same names; values re-tuned for light backgrounds",
    "border-subtle": "border-hair",
    "border-strong": "border-strong (now ink-900)",
    "border-input": "border-input"
  }
}
